SCRAPPY_ENV=production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=REPLACE_WITH_NEW_PRODUCTION_SECRET
MFA_ENCRYPTION_KEY=REPLACE_WITH_NEW_FERNET_KEY
DJANGO_ALLOWED_HOSTS=api.your-domain.example,app.your-domain.example
CSRF_TRUSTED_ORIGINS=https://app.your-domain.example
# User-facing frontend origin for invitation/reset links.
PUBLIC_ORIGIN=https://app.your-domain.example
# Enable only if your trusted hosting proxy sanitizes X-Forwarded-Proto.
TRUST_PROXY_SSL_HEADER=0
POSTGRES_DB=scrappy
POSTGRES_USER=REPLACE_WITH_DATABASE_USER
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
POSTGRES_HOST=REPLACE_WITH_DATABASE_HOST
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
REDIS_URL=rediss://default:REPLACE_WITH_REDIS_PASSWORD@REPLACE_WITH_REDIS_HOST:6379/0
# On Railway, use private reference variables instead of copying credentials:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# REDIS_URL=${{Redis.REDIS_URL}}
# Mount private persistent storage here; share it with document workers.
PRIVATE_STORAGE_PATH=/app/private-storage
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=REPLACE_WITH_SMTP_HOST
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=REPLACE_WITH_SMTP_USER
EMAIL_HOST_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
DEFAULT_FROM_EMAIL=accounts@your-domain.example
