SCRAPPY_ENV=development
DJANGO_SECRET_KEY=generate-a-unique-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver
POSTGRES_DB=scrappy
POSTGRES_USER=scrappy
POSTGRES_PASSWORD=generate-a-unique-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
REDIS_URL=redis://127.0.0.1:56379/0
PUBLIC_ORIGIN=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000
MFA_ENCRYPTION_KEY=generate-a-fernet-key

POSTGRES_SSLMODE=prefer
TRUST_PROXY_SSL_HEADER=0
